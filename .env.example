# ═══════════════════════════════════════════════════════════
# Copy to .env.local for local dev. On Vercel these go in
# Settings -> Environment Variables instead.
#
# Leave the VITE_ ones blank and the site runs exactly as it did
# before: everything saved to her browser and nowhere else.
# ═══════════════════════════════════════════════════════════

# --- Supabase (browser; these two ARE public, see supabase/schema.sql) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Mail (server only; NEVER prefix these with VITE_) ---
# GMAIL_APP_PASSWORD is a 16-character App Password from
# myaccount.google.com/apppasswords, not your Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_TO=
